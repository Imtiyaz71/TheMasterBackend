            "format": "double"
          },
          "discountPrice": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "validityDays": {
            "type": "integer",
            "format": "int32"
          },
          "totalVideos": {
            "type": "integer",
            "format": "int32"
          },
          "driveFolderLink": {
            "minLength": 1,
            "type": "string"
          },
          "isPublished": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
